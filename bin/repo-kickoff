#!/usr/bin/env bash
# repo-kickoff: generate a starter repository from a catalog of project types.
#
# Written for bash 3.2 (macOS) as well as bash 4 and 5 (Linux), with POSIX
# tools only: see docs/decisions/0001-dependency-free-bash.md.

set -eu
set -o pipefail

REPO_KICKOFF_VERSION=0.0.0

# Print the physical folder holding the file at $1, following any chain of
# symlinks to it. Portable: no `readlink -f`, which BSD readlink lacks.
real_dir_of() {
	local path=$1 dir link
	while [ -L "$path" ]; do
		dir=$(cd -P "$(dirname "$path")" && pwd)
		link=$(readlink "$path")
		case $link in
		/*) path=$link ;;
		*) path=$dir/$link ;;
		esac
	done
	cd -P "$(dirname "$path")" && pwd
}

# The clone repo-kickoff runs from, and its catalog of types.
# REPO_KICKOFF_TYPES points at another catalog, for tests.
ROOT=$(cd -P "$(real_dir_of "$0")/.." && pwd)
TYPES_DIR=${REPO_KICKOFF_TYPES:-$ROOT/types}

usage() {
	cat <<EOF
Usage: repo-kickoff [--dest DIR] <type> <name>
       repo-kickoff --help | --version

Generate a starter repository named <name> from the catalog type <type>.
Names and types are lower-case letters, digits and dashes, starting with a
letter.

Options:
  --dest DIR   create the repository in DIR/<name> (default: ./<name>)
  -h, --help   show this help and exit
  --version    show the version and exit

Types are read from: $TYPES_DIR
EOF
}

# Report an error and exit 1.
die() {
	printf 'repo-kickoff: %s\n' "$@" >&2
	exit 1
}

# Report a usage error and exit 2.
usage_error() {
	printf 'repo-kickoff: %s\n\n' "$1" >&2
	usage >&2
	exit 2
}

# is_valid_name WORD: WORD is a lower-case letter followed by lower-case
# letters, digits and dashes. Spelled out, since [a-z] can match capitals in
# some locales.
is_valid_name() {
	case $1 in
	[abcdefghijklmnopqrstuvwxyz]*) ;;
	*) return 1 ;;
	esac
	case $1 in
	*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
	esac
	return 0
}

# The staging folder of a repository being built, removed on exit.
STAGING=""
cleanup() {
	if [ -n "$STAGING" ]; then
		rm -rf "$STAGING"
	fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Print the known types, separated by ", ", or "(none)".
known_types() {
	local dir list=""
	for dir in "$TYPES_DIR"/*/; do
		[ -d "$dir" ] || continue
		dir=${dir%/}
		list="$list${list:+, }${dir##*/}"
	done
	echo "${list:-(none)}"
}

# Replace {{NAME}} with $NAME in standard input. NAME is escaped for sed.
substitute() {
	local escaped
	escaped=$(printf '%s' "$NAME" | sed 's/[\/&]/\\&/g')
	LC_ALL=C sed "s/{{NAME}}/$escaped/g"
}

# generate TYPE DEST: copy the type's template to DEST, replacing {{NAME}}
# in file contents and in file and folder names, and keeping executable bits.
generate() {
	local template=$TYPES_DIR/$1/template dest=$2 path out
	mkdir "$dest"
	(cd "$template" && find . -type d) | while IFS= read -r path; do
		mkdir -p "$dest/$(printf '%s' "$path" | substitute)"
	done
	(cd "$template" && find . -type f) | while IFS= read -r path; do
		out=$dest/$(printf '%s' "$path" | substitute)
		substitute <"$template/$path" >"$out"
		if [ -x "$template/$path" ]; then
			chmod +x "$out"
		fi
	done
}

main() {
	local type="" name="" dest_dir="" arg target
	while [ $# -gt 0 ]; do
		arg=$1
		shift
		case $arg in
		--dest)
			[ $# -gt 0 ] || usage_error "--dest needs a folder"
			dest_dir=$1
			shift
			;;
		--dest=*)
			dest_dir=${arg#--dest=}
			;;
		-h | --help)
			usage
			return 0
			;;
		--version)
			echo "repo-kickoff $REPO_KICKOFF_VERSION"
			return 0
			;;
		--)
			break
			;;
		-*)
			usage_error "unknown option: $arg"
			;;
		*)
			if [ -z "$type" ]; then
				type=$arg
			elif [ -z "$name" ]; then
				name=$arg
			else
				usage_error "unexpected argument: $arg"
			fi
			;;
		esac
	done
	# Arguments after `--` are positional, even if they start with a dash.
	while [ $# -gt 0 ]; do
		if [ -z "$type" ]; then
			type=$1
		elif [ -z "$name" ]; then
			name=$1
		else
			usage_error "unexpected argument: $1"
		fi
		shift
	done

	[ -n "$type" ] || usage_error "missing <type>"
	[ -n "$name" ] || usage_error "missing <name>"
	is_valid_name "$type" || usage_error "invalid type: $type"
	is_valid_name "$name" ||
		usage_error "invalid name: $name (use lower-case letters, digits and dashes, starting with a letter)"

	if [ -n "$dest_dir" ]; then
		[ -d "$dest_dir" ] || die "destination folder does not exist: $dest_dir"
		target=${dest_dir%/}/$name
	else
		dest_dir=.
		target=$name
	fi

	if [ ! -d "$TYPES_DIR/$type" ]; then
		die "unknown type: $type" "known types: $(known_types)"
	fi
	if [ ! -d "$TYPES_DIR/$type/template" ]; then
		die "type $type has no template folder: $TYPES_DIR/$type/template"
	fi
	if [ -e "$target" ] || [ -L "$target" ]; then
		die "$target already exists"
	fi

	# Build in a staging folder next to the target, then move it into place,
	# so a failure part-way never leaves a partial repository.
	NAME=$name
	STAGING=$(mktemp -d "$dest_dir/.repo-kickoff.XXXXXX")
	generate "$type" "$STAGING/$name"
	if [ -e "$target" ] || [ -L "$target" ]; then
		die "$target already exists"
	fi
	mv "$STAGING/$name" "$target"
	echo "Created $target from the $type type."
}

main "$@"
