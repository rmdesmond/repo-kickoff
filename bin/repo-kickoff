#!/usr/bin/env bash
# repo-kickoff: generate a starter repository from a catalog of project types.
#
# Written for bash 3.2 (macOS) as well as bash 4 and 5 (Linux), with POSIX
# tools only: see docs/decisions/0001-dependency-free-bash.md.

set -eu
set -o pipefail

REPO_KICKOFF_VERSION=0.1.0

# Print the physical folder holding the file at $1, following any chain of
# symlinks to it. Portable: no `readlink -f`, which BSD readlink lacks.
real_dir_of() {
	local path=$1 dir link
	while [ -L "$path" ]; do
		dir=$(cd -P "$(dirname "$path")" && pwd)
		link=$(readlink "$path")
		case $link in
		/*) path=$link ;;
		*) path=$dir/$link ;;
		esac
	done
	cd -P "$(dirname "$path")" && pwd
}

# The clone repo-kickoff runs from, and its catalog of types.
# REPO_KICKOFF_TYPES points at another catalog, for tests.
ROOT=$(cd -P "$(real_dir_of "$0")/.." && pwd)
TYPES_DIR=${REPO_KICKOFF_TYPES:-$ROOT/types}

usage() {
	cat <<EOF
Usage: repo-kickoff [--dest DIR] [--interactive] [<type> [<name>]]
       repo-kickoff --list
       repo-kickoff --check-type <type>
       repo-kickoff --help | --version

Generate a starter repository named <name> from the catalog type <type>.
At a terminal, a missing <type> or <name> is asked for.
Names and types are lower-case letters, digits and dashes, starting with a
letter.

Options:
  --dest DIR   create the repository in DIR/<name> (default: ./<name>)
  --list       list the known types and exit
  --check-type <type>
               check that a type is complete: it has a description and a
               template with tests/smoke.sh, and a repository generated from
               it passes its smoke test
  --interactive
               ask for a missing <type> or <name> even when standard input
               isn't a terminal, reading the answers from it
  -h, --help   show this help and exit
  --version    show the version and exit

Types are read from: $TYPES_DIR
EOF
}

# Report an error and exit 1.
die() {
	printf 'repo-kickoff: %s\n' "$@" >&2
	exit 1
}

# Report a usage error and exit 2.
usage_error() {
	printf 'repo-kickoff: %s\n\n' "$1" >&2
	usage >&2
	exit 2
}

# is_valid_name WORD: WORD is a lower-case letter followed by lower-case
# letters, digits and dashes. Spelled out, since [a-z] can match capitals in
# some locales.
is_valid_name() {
	case $1 in
	[abcdefghijklmnopqrstuvwxyz]*) ;;
	*) return 1 ;;
	esac
	case $1 in
	*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
	esac
	return 0
}

# The staging folder of a repository being built, removed on exit.
STAGING=""
cleanup() {
	if [ -n "$STAGING" ]; then
		rm -rf "$STAGING"
	fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Print the known types, separated by ", ", or "(none)".
known_types() {
	local dir list=""
	for dir in "$TYPES_DIR"/*/; do
		[ -d "$dir" ] || continue
		dir=${dir%/}
		list="$list${list:+, }${dir##*/}"
	done
	echo "${list:-(none)}"
}

# Print each type and the first line of its description, sorted by type,
# with the descriptions lined up.
list_types() {
	local dir type description
	for dir in "$TYPES_DIR"/*/; do
		[ -d "$dir" ] || continue
		dir=${dir%/}
		type=${dir##*/}
		description=""
		if [ -f "$dir/description" ]; then
			description=$(sed -n 1p "$dir/description")
		fi
		printf '%s\t%s\n' "$type" "${description:-(no description)}"
	done | LC_ALL=C sort | awk -F '\t' '
		{ type[NR] = $1; text[NR] = $2; if (length($1) > width) width = length($1) }
		END { for (i = 1; i <= NR; i++) printf "%-" width "s  %s\n", type[i], text[i] }'
	if [ "$(known_types)" = "(none)" ]; then
		echo "repo-kickoff: no types in $TYPES_DIR" >&2
	fi
}

# check_type TYPE: report every problem with the type on stderr and return
# 1, or say it passed and return 0. Generates a sample repository in a
# temporary folder, which is removed afterwards.
check_type() {
	local type=$1 dir problems=0 repo log
	dir=$TYPES_DIR/$type
	is_valid_name "$type" || usage_error "invalid type: $type"
	[ -d "$dir" ] || die "unknown type: $type" "known types: $(known_types)"

	problem() {
		printf 'repo-kickoff: %s: %s\n' "$type" "$1" >&2
		problems=$((problems + 1))
	}

	if [ ! -f "$dir/description" ]; then
		problem "no description file"
	elif [ -z "$(sed -n 1p "$dir/description")" ]; then
		problem "the description's first line is empty"
	fi

	if [ ! -d "$dir/template" ]; then
		problem "no template folder"
	elif [ ! -f "$dir/template/tests/smoke.sh" ]; then
		problem "no template/tests/smoke.sh"
	elif [ ! -x "$dir/template/tests/smoke.sh" ]; then
		problem "template/tests/smoke.sh is not executable"
	else
		NAME=kickoff-check
		STAGING=$(mktemp -d "${TMPDIR:-/tmp}/repo-kickoff-check.XXXXXX")
		repo=$STAGING/$NAME
		log=$STAGING/smoke.log
		generate "$type" "$repo"
		if ! (cd "$repo" && tests/smoke.sh) </dev/null >"$log" 2>&1; then
			problem "the smoke test failed in a generated repository; its output:"
			sed 's/^/    /' "$log" >&2
		fi
		rm -rf "$STAGING"
		STAGING=""
	fi

	if [ "$problems" -gt 0 ]; then
		printf 'repo-kickoff: %s: %s problem(s) found\n' "$type" "$problems" >&2
		return 1
	fi
	echo "ok: $type has a description and a template, and its smoke test passes"
}

# Read one line of standard input into the variable named $1. A last line
# without a newline counts; end of input with nothing read fails.
read_answer() {
	local line=""
	IFS= read -r line || [ -n "$line" ] || return 1
	eval "$1=\$line"
}

# Ask which type to use, showing the numbered types on stderr, until the
# answer is a number from the list or a type's name. Prints the type.
ask_type() {
	local types count answer
	[ "$(known_types)" != "(none)" ] || die "no types in $TYPES_DIR"
	types=$(list_types)
	count=$(printf '%s\n' "$types" | wc -l | tr -d ' ')
	echo "Known types:" >&2
	printf '%s\n' "$types" | awk '{ printf "  %d) %s\n", NR, $0 }' >&2
	while :; do
		printf 'Type (number or name): ' >&2
		read_answer answer || die "no answer for the type"
		case $answer in
		"") ;;
		*[!0-9]*)
			if is_valid_name "$answer" && [ -d "$TYPES_DIR/$answer" ]; then
				echo "$answer"
				return 0
			fi
			;;
		*)
			if [ "$answer" -ge 1 ] && [ "$answer" -le "$count" ]; then
				printf '%s\n' "$types" | sed -n "${answer}p" | awk '{ print $1 }'
				return 0
			fi
			;;
		esac
		echo "Not a known type: '$answer'" >&2
	done
}

# ask_name PREFIX: ask for the new repository's name until it's valid and
# PREFIX<name> doesn't exist. Prints the name.
ask_name() {
	local prefix=$1 answer
	while :; do
		printf 'Name of the new repository: ' >&2
		read_answer answer || die "no answer for the name"
		if ! is_valid_name "$answer"; then
			echo "Not a valid name: '$answer' (use lower-case letters, digits and dashes, starting with a letter)" >&2
		elif [ -e "$prefix$answer" ] || [ -L "$prefix$answer" ]; then
			echo "$prefix$answer already exists" >&2
		else
			echo "$answer"
			return 0
		fi
	done
}

# Replace {{NAME}} with $NAME in standard input. NAME is escaped for sed.
substitute() {
	local escaped
	escaped=$(printf '%s' "$NAME" | sed 's/[\/&]/\\&/g')
	LC_ALL=C sed "s/{{NAME}}/$escaped/g"
}

# generate TYPE DEST: copy the type's template to DEST, replacing {{NAME}}
# in file contents and in file and folder names, and keeping executable bits.
generate() {
	local template=$TYPES_DIR/$1/template dest=$2 path out
	mkdir "$dest"
	(cd "$template" && find . -type d) | while IFS= read -r path; do
		mkdir -p "$dest/$(printf '%s' "$path" | substitute)"
	done
	(cd "$template" && find . -type f) | while IFS= read -r path; do
		out=$dest/$(printf '%s' "$path" | substitute)
		substitute <"$template/$path" >"$out"
		if [ -x "$template/$path" ]; then
			chmod +x "$out"
		fi
	done
}

main() {
	local type="" name="" dest_dir="" interactive="" check="" arg prefix target
	while [ $# -gt 0 ]; do
		arg=$1
		shift
		case $arg in
		--dest)
			[ $# -gt 0 ] || usage_error "--dest needs a folder"
			dest_dir=$1
			shift
			;;
		--dest=*)
			dest_dir=${arg#--dest=}
			;;
		-h | --help)
			usage
			return 0
			;;
		--version)
			echo "repo-kickoff $REPO_KICKOFF_VERSION"
			return 0
			;;
		--list)
			list_types
			return 0
			;;
		--interactive)
			interactive=yes
			;;
		--check-type)
			[ $# -gt 0 ] || usage_error "--check-type needs a type"
			check=$1
			shift
			;;
		--check-type=*)
			check=${arg#--check-type=}
			;;
		--)
			break
			;;
		-*)
			usage_error "unknown option: $arg"
			;;
		*)
			if [ -z "$type" ]; then
				type=$arg
			elif [ -z "$name" ]; then
				name=$arg
			else
				usage_error "unexpected argument: $arg"
			fi
			;;
		esac
	done
	# Arguments after `--` are positional, even if they start with a dash.
	while [ $# -gt 0 ]; do
		if [ -z "$type" ]; then
			type=$1
		elif [ -z "$name" ]; then
			name=$1
		else
			usage_error "unexpected argument: $1"
		fi
		shift
	done

	if [ -n "$check" ]; then
		[ -z "$type" ] || usage_error "unexpected argument: $type"
		check_type "$check"
		return
	fi

	# Ask for what's missing only at a terminal, or with --interactive:
	# anywhere else, waiting for an answer could hang a script.
	if [ -z "$interactive" ] && [ ! -t 0 ]; then
		[ -n "$type" ] || usage_error "missing <type>"
		[ -n "$name" ] || usage_error "missing <name>"
	fi

	if [ -n "$dest_dir" ]; then
		[ -d "$dest_dir" ] || die "destination folder does not exist: $dest_dir"
		prefix=${dest_dir%/}/
	else
		dest_dir=.
		prefix=""
	fi

	if [ -z "$type" ]; then
		type=$(ask_type)
	fi
	is_valid_name "$type" || usage_error "invalid type: $type"
	if [ -n "$name" ]; then
		is_valid_name "$name" ||
			usage_error "invalid name: $name (use lower-case letters, digits and dashes, starting with a letter)"
	fi

	if [ ! -d "$TYPES_DIR/$type" ]; then
		die "unknown type: $type" "known types: $(known_types)"
	fi
	if [ ! -d "$TYPES_DIR/$type/template" ]; then
		die "type $type has no template folder: $TYPES_DIR/$type/template"
	fi
	if [ -z "$name" ]; then
		name=$(ask_name "$prefix")
	fi
	target=$prefix$name
	if [ -e "$target" ] || [ -L "$target" ]; then
		die "$target already exists"
	fi

	# Build in a staging folder next to the target, then move it into place,
	# so a failure part-way never leaves a partial repository.
	NAME=$name
	STAGING=$(mktemp -d "$dest_dir/.repo-kickoff.XXXXXX")
	generate "$type" "$STAGING/$name"
	if [ -e "$target" ] || [ -L "$target" ]; then
		die "$target already exists"
	fi
	mv "$STAGING/$name" "$target"
	echo "Created $target from the $type type."
}

main "$@"
